# Copy to /etc/peercraft/relay.env, root-owned mode 0600.
# Fill with a local editor on the server; never commit populated files.
CF_ACCOUNT_ID=
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=
CF_ANALYTICS_TOKEN=

# Optional automatic confirmed billing-period updates. Pin the ACTUAL Realtime
# subscription ID after checking it in Billing; token requires Billing Read.
CF_REALTIME_SUBSCRIPTION_ID=
CF_BILLING_TOKEN=
